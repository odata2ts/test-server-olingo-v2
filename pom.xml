<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runnable OData V2 test server: Apache Olingo 2 behind embedded Jetty, packaged as one executable jar.

  Deliberately small. Olingo ships a plain servlet (`ODataServlet`), so no JAX-RS runtime is needed, and
  the data is held in memory, so there is no database, no ORM and no Spring. What is left is Olingo,
  Jetty and a logging binding.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.odata2ts</groupId>
  <artifactId>test-server-olingo-v2</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>test-server-olingo-v2</name>
  <description>Apache Olingo 2 implementation of the odata2ts "Library" OData V2 feature test model</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Olingo 2 is a javax.* / Java 8 stack; both the language level and Jetty 9.4 follow from that -->
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <olingo.version>2.0.13</olingo.version>
    <jetty.version>9.4.57.v20241219</jetty.version>
    <slf4j.version>1.7.36</slf4j.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.olingo</groupId>
      <artifactId>olingo-odata2-core</artifactId>
      <version>${olingo.version}</version>
    </dependency>
    <!--
      The query-option machinery: ListsProcessor implements $filter, $orderby, $top, $skip,
      $inlinecount, $expand, $select, $count, $links and the function-import dispatch against a
      DataSource. Only its processor is used here - the annotation-driven EdmProvider that ships
      alongside it cannot express inheritance, so the EDM is hand-written instead.
    -->
    <dependency>
      <groupId>org.apache.olingo</groupId>
      <artifactId>olingo-odata2-annotation-processor-core</artifactId>
      <version>${olingo.version}</version>
    </dependency>

    <dependency>
      <groupId>org.eclipse.jetty</groupId>
      <artifactId>jetty-servlet</artifactId>
      <version>${jetty.version}</version>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>library-server</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.3</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.odata2ts.library.LibraryServer</mainClass>
                </transformer>
                <!-- Olingo locates its runtime implementation through META-INF/services -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
